---
import Layout from "../layouts/Layout.astro";
import Canva from "../components/Canva.astro";
---

<Layout title="CV | Valentin Malindi">
  <section class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-bold tracking-wide text-emerald-400 mb-3 text-center" data-reveal>
        Mon CV
      </h1>
      <p class="text-gray-400 text-center mb-8" data-reveal>
        Retrouvez mon CV en direct ci-dessous, toujours à jour.
      </p>

      <Canva />

      <div class="flex justify-center mt-8">
        <a
          href="https://www.canva.com/design/DAFh11gVV8A/Wlb0vhEvSZDf9q3F6mayhQ/view"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-emerald-500 hover:bg-emerald-400 text-gray-900 font-semibold px-6 py-3 rounded-xl shadow transition text-center"
        >
          Télécharger mon CV (version la plus récente)
        </a>
      </div>
    </div>
  </section>
</Layout>
