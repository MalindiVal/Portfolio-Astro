---
const orientations = [
  {
    title: "Développement web Full Stack",
    description:
      "Concevoir des applications web maintenables, côté front-end et back-end.",
    skills: ["TypeScript", "React", "Next.js", "Python", "FastAPI", "Bases de données"],
  },
  {
    title: "Développement Back-End",
    description:
      "Développer des API REST, travailler sur des bases de données SQL, concevoir des applications et les faire évoluer.",
    skills: ["Python", "C#", "API REST", "SQL"],
  },
  {
    title: "Informatique industrielle et systèmes",
    description:
      "J’ai développé une application de supervision et de contrôle de machines industrielles, et je veux continuer sur des sujets qui mêlent informatique, systèmes et industrie.",
    skills: ["Python", "C#", "PowerShell", "API", "Bases de données"],
  },
  {
    title: "Data Engineering",
    description:
      "Progresser en traitement des données, avec une approche issue du développement logiciel, et explorer les usages de l’IA dans les projets informatiques.",
    skills: ["Python", "SQL", "Traitement des données", "IA"],
  },
  {
    title: "Développement logiciel",
    description:
      "Concevoir, optimiser et moderniser des applications, avec un intérêt particulier pour l’architecture logicielle.",
    skills: ["C#", "Architecture logicielle", "Bases de données"],
  },
  {
    title: "DevOps",
    description:
      "Progresser en automatisation, CI/CD, conteneurisation, déploiement et administration d’environnements, à partir de mon expérience en développement logiciel et d’API.",
    skills: ["CI/CD", "Docker", "Automatisation", "Déploiement", "API"],
  },
];

const conditions = [
  { emoji: "📅", label: "Début", value: "Avant le 13 décembre 2026" },
  { emoji: "🔁", label: "Rythme", value: "2 semaines en entreprise / 2 semaines en cours" },
  { emoji: "📍", label: "Mobilité", value: "Région parisienne, Dijon, Auxerre" },
];
---
<section id="alternance" class="bg-gray-900 py-16 px-6">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl font-bold mb-8 text-center text-emerald-400" data-reveal>Recherche d’alternance</h2>

    <ul class="grid sm:grid-cols-3 gap-4 max-w-4xl mx-auto mb-10">
      {conditions.map((condition, i) => (
        <li
          class="bg-gray-950 border border-emerald-500/40 rounded-xl px-5 py-4 text-center shadow-lg"
          data-reveal
          style={`--reveal-delay: ${i * 120}ms`}
        >
          <span class="text-2xl" aria-hidden="true">{condition.emoji}</span>
          <p class="text-xs uppercase tracking-wide text-emerald-400 font-semibold mt-1">{condition.label}</p>
          <p class="text-gray-100 font-medium">{condition.value}</p>
        </li>
      ))}
    </ul>

    <p class="max-w-3xl mx-auto text-gray-400 text-center mb-12" data-reveal>
      Je recherche une <span class="text-gray-100 font-semibold">alternance de 3 ans</span> dans l’un de ces domaines&nbsp;:
    </p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {orientations.map((orientation, i) => (
        <article
          class="bg-gray-950 rounded-xl p-6 shadow-lg flex flex-col card-hover border border-gray-800 hover:border-emerald-500/50"
          data-reveal
          style={`--reveal-delay: ${(i % 3) * 120}ms`}
        >
          <h3 class="text-xl font-semibold mb-3">{orientation.title}</h3>
          <p class="text-gray-400 mb-5 flex-1">{orientation.description}</p>
          <ul class="flex flex-wrap gap-2">
            {orientation.skills.map((skill) => (
              <li class="bg-emerald-700 text-white px-3 py-1 rounded-full text-xs">{skill}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="text-center mt-12" data-reveal>
      <a
        href="#contact"
        class="inline-block bg-emerald-500 text-gray-900 px-6 py-3 rounded-xl font-semibold hover:bg-emerald-400 transition"
      >
        Me contacter pour une alternance
      </a>
    </div>
  </div>
</section>
