---
const base = import.meta.env.BASE_URL;

type Skill = { name: string; icon?: string; rounded?: boolean };

const categories: { title: string; skills: Skill[] }[] = [
  {
    title: "Langages",
    skills: [
      { name: "C#", icon: "csharp" },
      { name: "Go", icon: "go" },
      { name: "PHP", icon: "php" },
      { name: "HTML", icon: "html5" },
      { name: "CSS", icon: "css3" },
      { name: "JavaScript", icon: "javascript" },
      { name: "TypeScript", icon: "typescript" },
      { name: "Python", icon: "python" },
      { name: "Lua", icon: "lua" },
      { name: "PowerShell", icon: "powershell" },
    ],
  },
  {
    title: "Frameworks",
    skills: [
      { name: "ASP.NET", icon: "dotnet" },
      { name: "WPF" },
      { name: "React", icon: "react" },
      { name: "Next.js", icon: "nextjs", rounded: true },
      { name: "FastAPI", icon: "fastapi" },
    ],
  },
  {
    title: "Base de données",
    skills: [
      { name: "SQL" },
      { name: "SQL Server", icon: "mssql" },
      { name: "SQLite", icon: "sqlite" },
      { name: "MongoDB", icon: "mongodb" },
    ],
  },
  {
    title: "Outils",
    skills: [
      { name: "Docker", icon: "docker" },
      { name: "Git", icon: "git" },
      { name: "API REST" },
      { name: "WebSocket" },
    ],
  },
];
---
<section id="skills" class="py-16 px-6 max-w-6xl mx-auto">
  <h2 class="text-3xl font-bold mb-10 text-center text-emerald-400" data-reveal>Compétences</h2>

  <div class="grid md:grid-cols-2 gap-6">
    {categories.map((category, i) => (
      <div class="bg-gray-900 rounded-xl p-6 shadow-lg card-hover" data-reveal style={`--reveal-delay: ${(i % 2) * 120}ms`}>
        <h3 class="text-xl font-semibold mb-5">{category.title}</h3>
        <ul class="flex flex-wrap gap-3">
          {category.skills.map((skill) => (
            <li class="bg-gray-800 px-4 py-2 rounded-lg flex items-center gap-2 text-sm">
              {skill.icon && (
                <img
                  src={`${base}/icons/${skill.icon}.svg`}
                  alt=""
                  width="20"
                  height="20"
                  class:list={[skill.rounded && "rounded-full"]}
                />
              )}
              {skill.name}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
