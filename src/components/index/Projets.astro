---
// Les projets les plus récents d'après leur activité GitHub (voir src/lib/projects.ts)
import ProjectVisual from "../ProjectVisual.astro";
import { formatMonth, getFeaturedProjects } from "../../lib/projects";

const base = import.meta.env.BASE_URL;
const featured = await getFeaturedProjects();
---
<section id="projects" class="py-16 px-6 max-w-6xl mx-auto">
  <h2 class="text-3xl font-bold mb-10 text-center text-emerald-400" data-reveal>Projets récents</h2>

  <div class="grid md:grid-cols-2 gap-8">
    {featured.map((project, i) => (
      <article class="bg-gray-900 rounded-xl shadow-lg overflow-hidden flex flex-col card-hover" data-reveal style={`--reveal-delay: ${i * 120}ms`}>
        <ProjectVisual project={project} />
        <div class="p-6 flex flex-col flex-1">
          <h3 class="text-xl font-semibold mb-1">{project.title}</h3>
          {project.updatedAt && (
            <p class="text-xs text-gray-500 mb-3">
              Mis à jour en <time datetime={project.updatedAt.toISOString()}>{formatMonth(project.updatedAt)}</time>
            </p>
          )}
          <p class="text-gray-400 flex-1">{project.summary ?? project.description}</p>
        </div>
      </article>
    ))}
  </div>

  <div class="text-center mt-10" data-reveal>
    <a
      href={`${base}/projects`}
      class="inline-block border border-gray-700 text-gray-200 px-6 py-3 rounded-xl font-semibold hover:border-emerald-400 hover:text-emerald-400 transition"
    >
      Voir tous mes projets →
    </a>
  </div>
</section>
